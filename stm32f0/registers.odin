// ── DMA1: DMA controller ──

DMA1_BASE :: 0x40020000

DMA_ISR_Flag :: enum u32 {
    GIF1 = 0,
    TCIF1 = 1,
    HTIF1 = 2,
    TEIF1 = 3,
    GIF2 = 4,
    TCIF2 = 5,
    HTIF2 = 6,
    TEIF2 = 7,
    GIF3 = 8,
    TCIF3 = 9,
    HTIF3 = 10,
    TEIF3 = 11,
    GIF4 = 12,
    TCIF4 = 13,
    HTIF4 = 14,
    TEIF4 = 15,
    GIF5 = 16,
    TCIF5 = 17,
    HTIF5 = 18,
    TEIF5 = 19,
    GIF6 = 20,
    TCIF6 = 21,
    HTIF6 = 22,
    TEIF6 = 23,
    GIF7 = 24,
    TCIF7 = 25,
    HTIF7 = 26,
    TEIF7 = 27,
}

DMA_ISR_Set :: bit_set[DMA_ISR_Flag; u32]

DMA_IFCR_Flag :: enum u32 {
    CGIF1 = 0,
    CTCIF1 = 1,
    CHTIF1 = 2,
    CTEIF1 = 3,
    CGIF2 = 4,
    CTCIF2 = 5,
    CHTIF2 = 6,
    CTEIF2 = 7,
    CGIF3 = 8,
    CTCIF3 = 9,
    CHTIF3 = 10,
    CTEIF3 = 11,
    CGIF4 = 12,
    CTCIF4 = 13,
    CHTIF4 = 14,
    CTEIF4 = 15,
    CGIF5 = 16,
    CTCIF5 = 17,
    CHTIF5 = 18,
    CTEIF5 = 19,
    CGIF6 = 20,
    CTCIF6 = 21,
    CHTIF6 = 22,
    CTEIF6 = 23,
    CGIF7 = 24,
    CTCIF7 = 25,
    CHTIF7 = 26,
    CTEIF7 = 27,
}

DMA_IFCR_Set :: bit_set[DMA_IFCR_Flag; u32]

DMA_Reg :: struct {
    ISR: DMA_ISR_Set,  // 0x00 RO — DMA interrupt status register (DMA_ISR)
    IFCR: DMA_IFCR_Set,  // 0x04 WO — DMA interrupt flag clear register (DMA_IFCR)
    CCR1: u32,  // 0x08 RW — DMA channel configuration register (DMA_CCR)
    CNDTR1: u32,  // 0x0C RW — DMA channel 1 number of data register
    CPAR1: u32,  // 0x10 RW — DMA channel 1 peripheral address register
    CMAR1: u32,  // 0x14 RW — DMA channel 1 memory address register
    _reserved_001C: [4]u8,  // padding
    CCR2: u32,  // 0x1C RW — DMA channel configuration register (DMA_CCR)
    CNDTR2: u32,  // 0x20 RW — DMA channel 2 number of data register
    CPAR2: u32,  // 0x24 RW — DMA channel 2 peripheral address register
    CMAR2: u32,  // 0x28 RW — DMA channel 2 memory address register
    _reserved_0030: [4]u8,  // padding
    CCR3: u32,  // 0x30 RW — DMA channel configuration register (DMA_CCR)
    CNDTR3: u32,  // 0x34 RW — DMA channel 3 number of data register
    CPAR3: u32,  // 0x38 RW — DMA channel 3 peripheral address register
    CMAR3: u32,  // 0x3C RW — DMA channel 3 memory address register
    _reserved_0044: [4]u8,  // padding
    CCR4: u32,  // 0x44 RW — DMA channel configuration register (DMA_CCR)
    CNDTR4: u32,  // 0x48 RW — DMA channel 4 number of data register
    CPAR4: u32,  // 0x4C RW — DMA channel 4 peripheral address register
    CMAR4: u32,  // 0x50 RW — DMA channel 4 memory address register
    _reserved_0058: [4]u8,  // padding
    CCR5: u32,  // 0x58 RW — DMA channel configuration register (DMA_CCR)
    CNDTR5: u32,  // 0x5C RW — DMA channel 5 number of data register
    CPAR5: u32,  // 0x60 RW — DMA channel 5 peripheral address register
    CMAR5: u32,  // 0x64 RW — DMA channel 5 memory address register
    _reserved_006C: [4]u8,  // padding
    CCR6: u32,  // 0x6C RW — DMA channel configuration register (DMA_CCR)
    CNDTR6: u32,  // 0x70 RW — DMA channel 6 number of data register
    CPAR6: u32,  // 0x74 RW — DMA channel 6 peripheral address register
    CMAR6: u32,  // 0x78 RW — DMA channel 6 memory address register
    _reserved_0080: [4]u8,  // padding
    CCR7: u32,  // 0x80 RW — DMA channel configuration register (DMA_CCR)
    CNDTR7: u32,  // 0x84 RW — DMA channel 7 number of data register
    CPAR7: u32,  // 0x88 RW — DMA channel 7 peripheral address register
    CMAR7: u32,  // 0x8C RW — DMA channel 7 memory address register
}

#assert(size_of(DMA_Reg) == 144)

dma1 := (^DMA_Reg)(rawptr(uintptr(DMA1_BASE)))

