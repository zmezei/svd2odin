// ── NVIC: Nested Vectored Interrupt Controller ──

NVIC_BASE :: 0xE000E100

NVIC_Reg :: struct {
    ISER: u32,  // 0x00 RW — Interrupt Set Enable Register
    _reserved_0080: [124]u8,  // padding
    ICER: u32,  // 0x80 RW — Interrupt Clear Enable Register
    _reserved_0100: [124]u8,  // padding
    ISPR: u32,  // 0x100 RW — Interrupt Set-Pending Register
    _reserved_0180: [124]u8,  // padding
    ICPR: u32,  // 0x180 RW — Interrupt Clear-Pending Register
    _reserved_0300: [380]u8,  // padding
    IPR0: u32,  // 0x300 RW — Interrupt Priority Register 0
    IPR1: u32,  // 0x304 RW — Interrupt Priority Register 1
    IPR2: u32,  // 0x308 RW — Interrupt Priority Register 2
    IPR3: u32,  // 0x30C RW — Interrupt Priority Register 3
    IPR4: u32,  // 0x310 RW — Interrupt Priority Register 4
    IPR5: u32,  // 0x314 RW — Interrupt Priority Register 5
    IPR6: u32,  // 0x318 RW — Interrupt Priority Register 6
    IPR7: u32,  // 0x31C RW — Interrupt Priority Register 7
}

#assert(size_of(NVIC_Reg) == 800)

nvic := (^NVIC_Reg)(rawptr(uintptr(NVIC_BASE)))

